{
  "name": "@zod-monaco/monaco",
  "version": "4.0.0",
  "description": "Monaco editor adapter with Zod-powered JSON validation, hover, and completions",
  "license": "MIT",
  "author": "Kaan Akin",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/kaannakiin/zod-monaco#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaannakiin/zod-monaco.git",
    "directory": "packages/monaco"
  },
  "keywords": [
    "monaco",
    "monaco-editor",
    "editor",
    "json",
    "json-editor",
    "zod",
    "zod-v4",
    "validation",
    "schema",
    "typescript",
    "intellisense",
    "autocomplete"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:hover-audit": "vitest run src/__tests__/hover-audit.test.ts",
    "check-types": "tsc -p tsconfig.check.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@zod-monaco/core": "workspace:*"
  },
  "peerDependencies": {
    "monaco-editor": "^0.55.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "monaco-editor": "0.55.1",
    "typescript": "5.9.2",
    "vitest": "^4.1.1"
  }
}
