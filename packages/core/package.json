{
  "name": "@zod-monaco/core",
  "version": "3.3.3",
  "description": "Zod v4 runtime bridge for JSON Schema generation and validation",
  "license": "MIT",
  "author": "Kaan Akin",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://github.com/kaannakiin/zod-monaco#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaannakiin/zod-monaco.git",
    "directory": "packages/core"
  },
  "keywords": [
    "zod",
    "zod-v4",
    "json-schema",
    "validation",
    "schema",
    "typescript",
    "json"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsc --watch -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:hover-audit": "vitest run src/__tests__/hover-audit.test.ts",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "5.9.2",
    "vitest": "^4.1.1",
    "zod": "^4.0.0"
  }
}
